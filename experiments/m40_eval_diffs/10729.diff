--- a/app/src/terminal/model/blockgrid_tests.rs
+++ b/app/src/terminal/model/blockgrid_tests.rs
@@ -244,3 +244,117 @@ pub fn test_cursor_display_point_not_clipped_when_trimming_disabled() {
