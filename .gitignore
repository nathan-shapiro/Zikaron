# Secrets and credentials — never commit
.env
.env.*
*.pem
*.key

# Installer backups. `python -m zikaron.install --agent <config>` copies a config to
# `<config>.bak` before merging into it; that copy is local recovery state, not a project artifact.
/.kiro/agents/*.json.bak

# Editor / OS
*.swp
*~
.DS_Store

# Local code-intelligence config: absolute server paths for this machine, not a
# project convention.
.kiro/settings/lsp.json
# What an install into this repository writes: one machine's install, not a project artifact. The
# reference copy is the snapshot under tests/fixtures/installed/ (CLAUDE.md §Harness). The rest of
# .kiro/ — the crew configs, the dogfood config, the crew skills — is tracked deliberately.
/.kiro/agents/zikaron-consolidator.json
/.kiro/agents/zikaron-documenter.json
/.kiro/skills/zikaron-consolidate/
/.kiro/skills/zikaron-document-code/

# Per-machine Claude Code overrides, and what an install into this repository writes, for the
# reason above. The rest of .claude/ (agents, skills, shared settings) is tracked deliberately.
/.claude/settings.local.json*
/.mcp.json*
/.claude/agents/zikaron-*
/.claude/skills/zikaron-consolidate/
/.claude/skills/zikaron-document-code/

# Python
.venv/
venv/
# One virtualenv per Python version, built and reused by check-matrix.sh.
.venv-matrix/
__pycache__/
*.pyc
.hypothesis/
htmlcov/
*.egg-info/
# Trailing wildcards, not bare names: `check-matrix.sh` gives each Python version its own copy of
# every one of these so that versions can run concurrently — `.coverage.3.13`, `.mypy_cache.3.13`
# and so on. Without the wildcard those per-version paths are untracked-but-not-ignored, which makes
# them part of the working-tree identity that script samples before and after a run, and every
# parallel run then fails with "the tree changed during the run" for a reason that looks like an
# editing mistake.
.pytest_cache*
.ruff_cache*
.mypy_cache*
.coverage*

# Node
node_modules/
dist/
build/

# Rust / Go
target/

# Logs
*.log

# Zikaron's stores — local state, never committed (D19).
# Memories and every knowledge base's index live only in local SQLite; those FTS5 and
# sqlite-vec indexes and the downloaded embedding model are all rebuildable, so none of
# it belongs in git.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Anchored: a store anywhere but the top is a session in the wrong directory, better seen than hidden.
/.zikaron/
